# ==============================================================================
# CampusFlow — Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 2. Testing & Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
dist/
dist-ssr/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Database & Persistence Files
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3
*.sqlite
campusflow.db
backend/campusflow.db
database/campusflow.db

# ------------------------------------------------------------------------------
# 5. Uploads, User Content & Media Artifacts
# ------------------------------------------------------------------------------
backend/uploads/avatars/*
!backend/uploads/avatars/.gitkeep
uploads/avatars/*
!uploads/avatars/.gitkeep

# ------------------------------------------------------------------------------
# 6. Environment Variables, Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem
*.key
*.cert
*.crt
*.pfx

# Explicitly keep example template
!.env.example

# ------------------------------------------------------------------------------
# 7. Machine Learning Artifacts & Caches
# ------------------------------------------------------------------------------
ml/*.csv
!ml/dataset.csv
ml/__pycache__/

# ------------------------------------------------------------------------------
# 8. Operating System & IDE Configurations
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# VS Code & JetBrains
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs
*.log
logs/
