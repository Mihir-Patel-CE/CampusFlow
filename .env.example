# CampusFlow Platform Environment Configuration

# Server Settings
PROJECT_NAME="CampusFlow Platform"
API_V1_STR="/api/v1"

# Security & JWT Token
SECRET_KEY="generate-a-strong-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Settings
# For PostgreSQL (Production): postgresql://user:password@localhost:5432/campusflow_db
# For SQLite (Local Zero-Dependency Fallback): sqlite:///./campusflow.db
DATABASE_URL="sqlite:///./campusflow.db"

# Frontend API URL
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
